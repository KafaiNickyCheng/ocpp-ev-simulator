# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit real values

# Your LIFF App ID from LINE Developers Console
# e.g. 1234567890-AbcdEfgh
VITE_LIFF_ID=YOUR_LIFF_ID_HERE

# Your backend URL — use ngrok for local dev, production URL when deployed
# e.g. https://abc123.ngrok.io  or  https://ocpp-backend.railway.app
VITE_BACKEND_URL=http://localhost:5000
